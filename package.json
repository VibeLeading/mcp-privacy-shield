{
  "name": "mcp-privacy-shield",
  "version": "0.1.1",
  "description": "MCP server implementing the Vibe Leading Privacy Shield: PII sanitization, tiered sovereignty classification, and compliance scoring.",
  "type": "module",
  "bin": {
    "mcp-privacy-shield": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "prepare": "tsc && node -e \"require('node:fs').chmodSync('dist/index.js', 0o755)\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "privacy",
    "vibe-leading",
    "ai"
  ],
  "license": "MIT"
}